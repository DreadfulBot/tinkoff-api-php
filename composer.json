{
  "description": "OpenApi client for TBankApi on PHP language",
  "keywords": [
    "php",
    "openapi",
    "tbank",
    "tinkoff"
  ],
  "homepage": "https://roxl.net/tbank-openapi-php",
  "license": "MIT",
  "authors": [
    {
      "name": "Roxl",
      "homepage": "https://roxl.net"
    }
  ],
  "require": {
    "php": "^7.4 || ^8.0",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^1.7 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.0 || ^9.0",
    "friendsofphp/php-cs-fixer": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "Roxl\\TBankApi\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Roxl\\TBankApi\\Test\\": "test/"
    }
  },
  "name": "roxl/tbankapi"
}
